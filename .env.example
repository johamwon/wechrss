# 推荐直接在 Web 设置页使用“微信扫码登录”，以下凭证环境变量仅用于兼容旧部署。
WEREAD_ACCESS_TOKEN=
WEREAD_VID=
WEREAD_REFRESH_TOKEN=
WEREAD_DEVICE_ID=
WEREAD_PROFILE=

# 如 Web 管理端不只监听本机，请设置管理员密码。用户名固定：admin
ADMIN_PASSWORD=
BIND_ADDRESS=127.0.0.1
PORT=8080

# 允许被哪些源以 iframe 嵌入（空格分隔，留空=禁止嵌入，自托管建议保持禁止）。
# 部署到 ModelScope 创空间等 iframe 平台时需设置为对应域名，例如：
# ALLOWED_FRAME_ANCESTORS=https://www.modelscope.cn https://modelscope.cn
ALLOWED_FRAME_ANCESTORS=

# 默认限速，不建议调低。
WEREAD_MIN_INTERVAL=2
HTTP_TIMEOUT=20
WEREAD_QR_DEADLINE_SECONDS=300
SCHEDULER_POLL_SECONDS=30

# 数据目录
WECHAT_MP_DATA=/app/data
WECHAT_MP_DB=/app/data/wechat_mp.db
WECHAT_MP_CREDENTIALS=/app/data/credentials.json
